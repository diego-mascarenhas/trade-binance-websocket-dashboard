SYMBOL=btcusdt
INTERVAL=1m
DEPTH_LEVELS=20
MAX_CANDLES=200
MIN_CONFIDENCE=50
MIN_PATTERN_RANGE_PCT=0.02
OB_WALL_RANGE_PCT=0.6
SIGNAL_ZONE_LONG_ENTER=20
SIGNAL_ZONE_LONG_EXIT=35
SIGNAL_ZONE_SHORT_ENTER=80
SIGNAL_ZONE_SHORT_EXIT=65
SIGNAL_DEBOUNCE_COUNT=5
MAX_ENTRY_MARKERS=50
HTF_INTERVAL=15m
HTF_CANDLES=120
REQUIRE_TREND_ALIGN=true
SIGNAL_COOLDOWN_SEC=180
# WebSocket keepalive (higher timeout helps on busy VPS with many pairs)
WS_PING_INTERVAL=20
WS_PING_TIMEOUT=90
# Throttle signal recalc on depth bursts (order book still updates every tick)
DEPTH_METRICS_INTERVAL_SEC=0.25
EMA_FAST=9
EMA_SLOW=21
HTF_EMA_TREND=50
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
SWING_LOOKBACK=20
TRADE_PLAN_DCA_STEPS=2
# Plan chart spacing between DCA levels (% per step; execution uses valid-entry prices)
TRADE_PLAN_DCA_STEP_PCT=2.5
# Cushion beyond structure / below last planned DCA level (%)
TRADE_PLAN_SL_BUFFER_PCT=0.25
# Minimum distance entry ↔ SL on open positions (%); blocks accidental BE-level stops
TRADE_PLAN_SL_MIN_DISTANCE_PCT=1.0
SL_REPRICE_TOLERANCE_PCT=0.35
TRADE_PLAN_TP1_RR=1.0
# Re-place TP algo when trigger drifts more than this % from recalculated target
TP_REPRICE_TOLERANCE_PCT=0.5
TRADE_PLAN_TP2_RR=2.0
TRADE_PLAN_PARTIAL_CLOSE_PCT=70
# After ~partial close % detected, move SL to entry on remaining qty (default on)
TRADE_PLAN_AUTO_BE=true
TRADE_PLAN_BE_BUFFER_PCT=0.05
PARTIAL_CLOSE_DETECT_TOLERANCE_PCT=8
# Break-even triggers (either can fire; signal = earlier than waiting for TP1 partial)
BE_TRIGGER_SIGNAL=true
BE_TRIGGER_PARTIAL=true
BE_MIN_PROFIT_PCT=0.25
# BE_MIN_PROFIT_USDT=1
BE_ON_HTF_NEUTRAL=true
BE_ON_HTF_AGAINST=true
BE_ON_SMC_RANGING=true
BE_ON_RSI_EXIT=true
# BE_ON_EMA_FLIP=false
BE_RSI_LONG_EXIT_MAX=70
BE_RSI_SHORT_EXIT_MIN=30
TRADE_PLAN_TRAIL_PCT=0.25
TRADE_PLAN_INITIAL_SIZE_PCT=50
# true = multi-leg DCA; false = first leg only (legacy single entry)
TRADE_PLAN_EXECUTE_DCA=true
# true = one leg per valid entry (SL protects between signals); false = all limits at once
TRADE_PLAN_DCA_SIGNAL_DRIVEN=true
# DCA adds only when position is underwater (not when already in profit)
TRADE_PLAN_DCA_ADVERSE_ONLY=true
# Block DCA add if unrealized PnL is above this (USDT); 0 = must be <= 0
DCA_FAVORABLE_PNL_MAX_USDT=0
# With adverse-only + signal-driven: DCA2/DCA3 use plan prices (above entry SHORT / below LONG)
LOG_DIR=logs

# Account PnL panel (/analytics/ only)
# Realized daily avg = sum(closed trades) / calendar days in lookback
PNL_STATS_LOOKBACK_DAYS=30
MILLION_GOAL_USDT=1000000
# Optional ROI baseline override (default: auto from logs/account_baseline.json)
# ACCOUNT_BASELINE_USDT=5000
ACCOUNT_SNAPSHOT_CACHE_SEC=15

# Indicator filters (applied before valid entry)
INDICATOR_FILTERS_ENABLED=true
RSI_FILTER_ENABLED=true
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
MACD_FILTER_ENABLED=false
ADX_PERIOD=14
ADX_FILTER_ENABLED=true
ADX_MIN_TREND=25
ADX_USE_HTF=true

# MySQL (optional — DeepSeek / per-symbol config; DB_ENABLED=false = .env only)
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=deepseek
DB_USER=deepseek
DB_PASSWORD=
DB_CONNECT_TIMEOUT=3

# DeepSeek AI suggestions (analytics /analytics/ → Analyze)
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=1800
DEEPSEEK_TIMEOUT=60
DEEPSEEK_SUGGESTIONS_COOLDOWN=300

# Order execution (Binance Futures REST)
EXECUTION_ENABLED=false
EXECUTE_ON_VALID_ENTRY=true
EXECUTION_MODE=dry
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
FAPI_BASE=https://fapi.binance.com
POSITION_SIZE_USDT=25
POSITION_WALLET_PCT=0
LEVERAGE=4
REST_PLACE_SL_TP=true
REST_SL_TP_FILL_WAIT=90
REST_SL_TP_POLL_INTERVAL=2
TP_ORDER_TYPE=trailing
TP_TRAILING_CALLBACK_RATE=0.5
EXECUTION_ORDER_COOLDOWN=180
# Same Binance error for same symbol: at most one Telegram alert per N seconds
ORDER_FAIL_NOTIFY_COOLDOWN=120
# Cancel unfilled entry LIMIT orders after N seconds (0 = disabled)
ENTRY_LIMIT_TTL_SEC=600
# How often each dashboard checks SL/TP + stale limits (live only)
EXECUTION_MAINTENANCE_SEC=15
PROTECTION_RECONCILE_ENABLED=true
# Max % one side may exceed the other (positions + pending entry limits). 0 = off
FLEET_SIDE_BALANCE_MAX_PCT=20
FLEET_EXPOSURE_CACHE_SEC=8

# Telegram (optional — same style as trade-binance-websocket-order-blocks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DASH_HOST=0.0.0.0
DASH_PORT=8050

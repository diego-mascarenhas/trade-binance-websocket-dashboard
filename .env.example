SYMBOL=btcusdt
INTERVAL=1m
DEPTH_LEVELS=20
MAX_CANDLES=200
MIN_CONFIDENCE=60
MIN_PATTERN_RANGE_PCT=0.02
OB_WALL_RANGE_PCT=0.6
SIGNAL_ZONE_LONG_ENTER=20
SIGNAL_ZONE_LONG_EXIT=30
SIGNAL_ZONE_SHORT_ENTER=80
SIGNAL_ZONE_SHORT_EXIT=70
SIGNAL_DEBOUNCE_COUNT=2
MAX_ENTRY_MARKERS=50
HTF_INTERVAL=15m
HTF_CANDLES=120
REQUIRE_TREND_ALIGN=true

WS_PING_INTERVAL=20
WS_PING_TIMEOUT=180
WS_FEED_SUMMARY_SEC=60
FLEET_WS_STAGGER_MAX_SEC=120

SIGNAL_COOLDOWN_SEC=180
EMA_FAST=9
EMA_SLOW=21
HTF_EMA_TREND=50
RSI_PERIOD=14
MACD_FAST=12
MACD_SLOW=26
MACD_SIGNAL=9
SWING_LOOKBACK=20
TRADE_PLAN_DCA_STEPS=2
TRADE_PLAN_DCA_STEP_PCT=2.5
TRADE_PLAN_SL_BUFFER_PCT=0.25
TRADE_PLAN_TP1_RR=1.0
TRADE_PLAN_TP2_RR=2.0
TRADE_PLAN_PARTIAL_CLOSE_PCT=70
TRADE_PLAN_TRAIL_PCT=0.25
TRADE_PLAN_INITIAL_SIZE_PCT=50
TRADE_PLAN_DCA_COMPENSATION=
TRADE_PLAN_DCA_EQUAL_SPLIT=
TRADE_PLAN_DCA_DISTANCE_WEIGHTED=
TRADE_PLAN_EXECUTE_DCA=true
TRADE_PLAN_DCA_SIGNAL_DRIVEN=false
TRADE_PLAN_DCA_ADVERSE_ONLY=false
DCA_DEFER_PROTECTION_UNTIL_LAST_LEG=false
LOG_DIR=logs

# Indicator filters (applied before valid entry)
INDICATOR_FILTERS_ENABLED=true
RSI_FILTER_ENABLED=true
RSI_LONG_MAX=70
RSI_SHORT_MIN=30
MACD_FILTER_ENABLED=false
ADX_PERIOD=14
ADX_FILTER_ENABLED=true
ADX_MIN_TREND=12
ADX_USE_HTF=true

# MySQL (optional — DeepSeek / per-symbol config; DB_ENABLED=false = .env only)
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=deepseek
DB_USER=deepseek
DB_PASSWORD=
DB_CONNECT_TIMEOUT=3

CONFIG_PAGE_TOKEN=

# DeepSeek AI suggestions (analytics /analytics/ → Analyze)
DEEPSEEK_ENABLED=false
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_MAX_TOKENS=1800
DEEPSEEK_TIMEOUT=60
DEEPSEEK_SUGGESTIONS_COOLDOWN=300

# Order execution (Binance Futures REST)
EXECUTION_ENABLED=false
EXECUTE_ON_VALID_ENTRY=true
EXECUTION_MODE=dry
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
FAPI_BASE=https://fapi.binance.com
POSITION_SIZE_USDT=25
POSITION_WALLET_PCT=10
LEVERAGE=4
REST_PLACE_SL_TP=true
REST_SL_TP_FILL_WAIT=90
REST_SL_TP_POLL_INTERVAL=2
TP_ORDER_TYPE=trailing
TP_TRAILING_ACTIVATION_PCT=0.3
TP_TRAILING_CALLBACK_RATE=0.2
TP_TRAILING_DB_ADAPTIVE=false
TP_TRAILING_DB_LOOKBACK_DAYS=14
TP_TRAILING_DB_MIN_TRADES=12
TP_TRAILING_DB_QUANTILE=0.35
TP_TRAILING_DB_REFRESH_SEC=900
TP_TRAILING_DB_MAX_PCT=1.2
TP_TRAILING_DB_GLOBAL_FALLBACK=true
EXECUTION_ORDER_COOLDOWN=180

# Scalper + trailing SL — fleet default OFF; enable per symbol in MySQL (LTCUSDT preset).
SCALPER_MODE=false
TRAIL_SL_ENABLED=false
TRAIL_SL_FEE_PCT=0.15
TRAIL_SL_CANDLE_OFFSET=1
TRAIL_CANDLE_DIAG_LOG=true
OB_EXIT_MIN_PROFIT_PCT=0.10


# Telegram (optional — same style as trade-binance-websocket-order-blocks)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

DASH_HOST=0.0.0.0
DASH_PORT=8050
